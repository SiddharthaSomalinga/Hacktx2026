{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "WebWorker"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": [
      "vite-plugin-pwa/client"
    ]
  },
  "include": [
    "src/sw"
  ]
}
