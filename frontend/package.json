{
  "name": "synapse",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": "^22.12 || ^24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.sw.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.sw.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "api:types": "openapi-typescript http://localhost:8000/openapi.json -o src/api/schema.gen.ts",
    "map:tiles": "node scripts/map/extract-tiles.mjs",
    "map:glyphs": "node scripts/map/fetch-glyphs.mjs",
    "map:footprints": "node scripts/map/fetch-footprints.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@tanstack/query-sync-storage-persister": "5.104.5",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-query-persist-client": "5.104.5",
    "lucide-react": "1.61.0",
    "maplibre-gl": "6.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "3.0.0",
    "@playwright/test": "1.64.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "pbf": "5.1.2",
    "pmtiles": "4.5.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-build": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
