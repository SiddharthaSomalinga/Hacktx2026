# Copy to .env and fill in. Never commit .env.
# Required
DATABASE_URL=
SECRET_KEY=
NODE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional
DATABASE_READ_URL=
MUSE_API_KEY=
FRONTEND_DIST=
COOKIE_SECURE=false
WORKER_ENABLED=true
# Per process; workers x instances x DB_POOL_SIZE (x2 with a replica) < max_connections
DB_POOL_SIZE=5

# Thresholds (defaults in app/config.py; REQUIREMENTS §8). Demo sets GHOST_S=15.
# GHOST_S=30
